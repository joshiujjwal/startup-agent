# ─── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...                        # GPT-4o API key with Assistants API access
OPENAI_ASSISTANT_ID=asst_...                 # Create via platform.openai.com or bootstrap script

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/startup_agent

# ─── Clerk (Auth) ──────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_WEBHOOK_SECRET=whsec_...               # For user provisioning webhook

# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173             # Allowed CORS origin

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379             # Used for rate limiting + caching

# ─── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=                                  # Optional: Sentry error tracking DSN
LOG_LEVEL=debug                              # pino log level: trace|debug|info|warn|error
